<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <AssemblyName>TOR-ChanceModifier</AssemblyName>
        <Version>1.0.0</Version>
        <Description>Chance – Alles ist zufällig! Modifier für TheOtherRoles</Description>
    </PropertyGroup>

    <!-- Dieselben Packages wie TOR -->
    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2024.10.29" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" />
        <PackageReference Include="Reactor" Version="2.3.1" />
    </ItemGroup>

    <!-- TOR als Hard-Dependency referenzieren -->
    <ItemGroup>
        <Reference Include="TheOtherRoles">
            <HintPath>..\TheOtherRoles-main\TheOtherRoles-main\TheOtherRoles\bin\Debug\net6.0\TheOtherRoles.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- Nach dem Build die DLL in den plugins-Ordner kopieren (falls AmongUsLatest gesetzt) -->
    <Target Name="CopyToBepInEx" AfterTargets="AfterBuild" Condition="Exists('$(AmongUsLatest)/BepInEx/plugins/')">
        <Copy SourceFiles="$(ProjectDir)\bin\$(Configuration)\net6.0\TOR-ChanceModifier.dll"
              DestinationFolder="$(AmongUsLatest)/BepInEx/plugins/" />
    </Target>
</Project>
