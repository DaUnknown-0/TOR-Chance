<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <AssemblyName>TOR-ChanceModifier</AssemblyName>
        <Version>1.0.13</Version>
        <Description>Chance – Everything is random! Modifier for TheOtherRoles</Description>
    </PropertyGroup>

    <!-- Same packages as TOR -->
    <ItemGroup>
        <PackageReference Include="AmongUs.GameLibs.Steam" Version="2024.10.29" />
        <PackageReference Include="BepInEx.IL2CPP.MSBuild" Version="2.1.0-rc.1" />
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.697" />
        <PackageReference Include="Reactor" Version="2.3.1" />
    </ItemGroup>

    <!-- TOR DLL location: defaults to the local build, overridable in CI via -p:TheOtherRolesDll=... -->
    <PropertyGroup>
        <TheOtherRolesDll Condition="'$(TheOtherRolesDll)' == ''">..\TheOtherRoles-main\TheOtherRoles-main\TheOtherRoles\bin\Debug\net6.0\TheOtherRoles.dll</TheOtherRolesDll>
    </PropertyGroup>

    <!-- Reference TOR as hard dependency -->
    <ItemGroup>
        <Reference Include="TheOtherRoles">
            <HintPath>$(TheOtherRolesDll)</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <!-- After build, copy the DLL into the plugins folder (if AmongUsLatest is set) -->
    <Target Name="CopyToBepInEx" AfterTargets="AfterBuild" Condition="Exists('$(AmongUsLatest)/BepInEx/plugins/')">
        <Copy SourceFiles="$(ProjectDir)\bin\$(Configuration)\net6.0\TOR-ChanceModifier.dll"
              DestinationFolder="$(AmongUsLatest)/BepInEx/plugins/" />
    </Target>
</Project>
